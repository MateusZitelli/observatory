{
  "name": "observatorio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run check && vite build && cp pano360.jpg dist/pano360.jpg",
    "check": "npm run check:lines && npm run lint && npm run typecheck",
    "check:lines": "node scripts/check-lines.ts",
    "dev": "vite",
    "lint": "oxlint src scripts vite.config.ts --max-warnings 0 --report-unused-disable-directives",
    "lint:fix": "npm run lint -- --fix",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "0.128.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "3.4.17",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
